# Copy this file to ".env" (in this mod folder) to change optional settings.
# Balatro High Stakes plays over Steam only (peer-to-peer: the host's Balatro is the server,
# friends join with the lobby code). The installer writes mode=steam; other modes and
# server_url / server_port are no longer used (removed in 0.6.8).
mode=steam

# Diagnostics (off by default): host a lobby by itself at startup and log "P2P-SELFTEST" lines
#p2p_selftest=true

# Update check (on by default): set to false to never contact GitHub for new versions
#update_check=false
